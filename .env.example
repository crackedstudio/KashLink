# Nimiq network the in-app light client connects to. Must match the network Nimiq Pay is on.
# Defaults: TestAlbatross in `npm run dev`, MainAlbatross in production builds.
# VITE_NIMIQ_NETWORK=TestAlbatross

# Public HTTPS URL the shared links point to (e.g. https://kashlink.example.com/).
# Defaults to the URL the mini app was loaded from.
# VITE_PUBLIC_URL=

# Shared links are nimpay.app "open" links by default, which open straight in Nimiq Pay on phones that
# have it installed. Recipients without the app land on nimpay.app, which only knows mini apps listed in
# the Nimiq Pay directory (github.com/nimiq/awesome). Until KashLink is listed there, set this to `false`
# to share the plain mini app URL instead (opens in the browser, with an "Open in Nimiq Pay" button).
# VITE_DIRECT_LINKS=false
