# Nimiq network the in-app light client connects to. Must match the network Nimiq Pay is on.
# Defaults: TestAlbatross in `npm run dev`, MainAlbatross in production builds.
# VITE_NIMIQ_NETWORK=TestAlbatross

# Public HTTPS URL the shared links point to (e.g. https://kashlink.example.com/).
# Defaults to the URL the mini app was loaded from.
# VITE_PUBLIC_URL=

# Shared links are nimpay.app "open" links by default, which open straight in Nimiq Pay on phones that
# have it installed. Recipients without the app land on nimpay.app, which only knows mini apps listed in
# the Nimiq Pay directory (github.com/nimiq/awesome). Until KashLink is listed there, set this to `false`
# to share the plain mini app URL instead (opens in the browser, with an "Open in Nimiq Pay" button).
# VITE_DIRECT_LINKS=false

# Supabase project for usage analytics (see supabase/schema.sql). Leave both unset to disable
# tracking entirely — the app works the same without them. Use the *anon* key, never service_role:
# this key ships inside the app bundle, and row-level security limits it to appending events.
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=

# Gas relayer for USDT links (supabase/functions/relay). Without it, USDT links are switched off and
# the app is NIM-only. Polygon only accepts POL for gas and a link address holds none, so the relayer
# submits the signed transfer and pays the gas itself.
# VITE_RELAY_URL=https://<project>.supabase.co/functions/v1/relay

# Optional: a dedicated Polygon RPC. The default public one has no uptime guarantee.
# VITE_POLYGON_RPC_URL=

# Server-side only, set with `supabase secrets set` — NEVER a VITE_ variable, which would ship the
# key to every visitor:
#   RELAYER_PRIVATE_KEY=0x...
#   POLYGON_RPC_URL=
