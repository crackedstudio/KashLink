# Nimiq network the in-app light client connects to. Must match the network Nimiq Pay is on.
# Defaults: TestAlbatross in `npm run dev`, MainAlbatross in production builds.
# VITE_NIMIQ_NETWORK=TestAlbatross

# Public HTTPS URL the shared links point to (e.g. https://cashlink.example.com/).
# Defaults to the URL the mini app was loaded from.
# VITE_PUBLIC_URL=
